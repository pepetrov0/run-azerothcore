# Copy to .env (next to the azeroth script) and adjust. The script reads it on every run.
# A variable already set in the environment when calling ./azeroth wins over this file.
# Values with spaces must be quoted; $(...) and backticks are expanded, so this is a shell file.

# Shared volume. A relative path is resolved against the current directory, so an absolute
# path is safer when running the script from elsewhere. Default when unset: ./data next to the script.
#AZEROTH_VOL=/srv/azeroth-data

# fetch
#AC_REPO=https://github.com/azerothcore/azerothcore-wotlk.git
#AC_BRANCH=master
#AC_CLIENT_URL=https://github.com/wowgaming/client-data/releases/latest/download/Data.zip

# build
#JOBS=4
#CTYPE=RelWithDebInfo

# aio
#FORCE_BUILD=1
#AC_PULL=1
